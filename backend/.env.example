# Postis API Credentials
POSTIS_BASE_URL=https://shipments.postisgate.com
POSTIS_USERNAME=your_postis_username
POSTIS_PASSWORD=your_postis_password

# Frontend domains allowed to call this API (comma-separated).
# Example: CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://www.app.yourdomain.com
# Leave empty only for local/dev.
CORS_ALLOWED_ORIGINS=

# Backend Security
# Use a long random value (minimum 32 characters).
JWT_SECRET=generate_a_random_string_here

# Database (default: local SQLite)
DATABASE_URL=sqlite:///./postis_pwa.db

# Supabase (example pooler connection string)
# Note: The pooler host varies by project/region. Copy the exact URL from Supabase Dashboard.
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# Driver Management
# Drivers are managed directly in the database via /users and Settings -> Refresh Drivers.

# Background Postis Sync (optional)
# Poll Postis v3 list and refresh changed shipments into the DB.
# Enabled by default for live deployments. If AUTO_SYNC_POSTIS is unset, the backend
# will auto-enable sync when POSTIS_USERNAME/POSTIS_PASSWORD are present.
AUTO_SYNC_POSTIS=1
AUTO_SYNC_POSTIS_INTERVAL_SECONDS=3600
AUTO_SYNC_POSTIS_PAGE_SIZE=100
# Also hit the v2 list endpoint (some accounts expose extra fields there).
AUTO_SYNC_POSTIS_USE_V2_LIST=1
AUTO_SYNC_POSTIS_CONCURRENCY=6
# AUTO_SYNC_POSTIS_MAX_AWBS_PER_RUN=500
AUTO_SYNC_POSTIS_INCLUDE_MISSING_RAW=0
# Backfill details for shipments missing critical fields (e.g. cost/content) even if status didn't change.
AUTO_SYNC_POSTIS_ENRICH_MISSING_FIELDS=1
AUTO_SYNC_POSTIS_MISSING_FIELDS_LIMIT=300
# Background geocoding refresh (DB cache-first, then Google Geocoding, then Nominatim fallback).
AUTO_SYNC_POSTIS_GEOCODE_REFRESH=1
AUTO_SYNC_POSTIS_GEOCODE_LIMIT=1200
APP_GEOCODER_USER_AGENT=arynik-sync/1.0
# Provider chain: google_then_nominatim | nominatim_then_google | google | nominatim
APP_GEOCODER_PROVIDER=google_then_nominatim
APP_GEOCODER_MIN_DELAY_MS=900
APP_GOOGLE_GEOCODER_MIN_DELAY_MS=80
APP_GEOCODER_TIMEOUT_SECONDS=12
APP_GEOCODE_RETRY_HOURS=24
AUTO_SYNC_POSTIS_STARTUP_JITTER_SECONDS=30
AUTO_SYNC_POSTIS_RUN_IMMEDIATELY=1

# Google APIs (server-side only; never expose in frontend).
GOOGLE_MAPS_API_KEY=your_google_maps_server_key

# Route planning controls
# Keep demo/test drivers out of planning/assignment.
ROUTE_PLANNING_EXCLUDED_DRIVER_IDS=D002
ROUTE_PLANNING_EXCLUDED_DRIVER_USERNAMES=demo
ROUTE_PLANNING_EXCLUDED_DRIVER_NAME_TOKENS=demo

# Capacity planning (m3/kg). Default OFF in code for routing reliability.
# Set to 1 to enforce vehicle target volume/weight constraints.
ROUTE_PLANNING_USE_CAPACITY=0
ROUTE_PLANNING_MAX_STOPS_PER_ROUTE=25
